# --- Database ---
# Local development defaults to SQLite. docker-compose and production use PostgreSQL.
DATABASE_URL=sqlite:///./tradelab.db
# DATABASE_URL=postgresql+psycopg://tradelab:tradelab@localhost:5432/tradelab

# --- Cache ---
# Optional. When unset, an in-process TTL cache is used (single-instance only).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Token required for POST /api/v1/admin/* endpoints. Leave empty to disable admin routes.
ADMIN_TOKEN=

# --- nba_api / NBA.com client safeguards ---
NBA_API_TIMEOUT_SECONDS=45
NBA_API_MAX_RETRIES=4
NBA_API_MIN_REQUEST_INTERVAL_SECONDS=0.75
NBA_API_MAX_CONCURRENCY=2
NBA_API_CACHE_TTL_SECONDS=3600
NBA_API_STALE_AFTER_SECONDS=86400
NBA_API_USER_AGENT=
NBA_API_HTTP_PROXY=

# --- Seasons ---
# The season treated as "current" for rosters/stats (NBA season string).
CURRENT_SEASON=2025-26
# Historical seasons ingested for modeling (comma-separated, oldest first).
HISTORY_SEASONS=2023-24,2024-25,2025-26
# League year whose cap parameters govern trade legality. Deliberately AHEAD of
# CURRENT_SEASON: a trade executed in July 2026 falls under the 2026-27 cap even
# though 2025-26 is the last completed stats season. Do not unify the two.
CAP_LEAGUE_YEAR=2026-27

# --- Background scheduler (docker compose `worker` service; `make worker` locally) ---
# Roster/standings refresh cadence and stats refresh cadence, in hours.
SYNC_ROSTERS_EVERY_HOURS=6
SYNC_STATS_EVERY_HOURS=24

# --- Contract / salary provider (optional; nba_api does not provide contracts) ---
# Supported: "" (none), "file" (user CSV; see data/contracts/README.md),
# "bbref_snapshot" (user-downloaded basketball-reference.com contracts page saved to
# data/imports/contracts/players.html — no live scraping)
CONTRACT_DATA_PROVIDER=
CONTRACT_DATA_API_KEY=
CONTRACT_DATA_FILE=

# --- Local media assets (user-supplied datasets; gitignored, served by the backend) ---
# Defaults: <repo>/nbalogos and <repo>/nbaplayerimages
ASSET_LOGOS_DIR=
ASSET_PLAYER_IMAGES_DIR=

# --- Kaggle historical dataset (kagglehub cache override; public dataset, no auth) ---
KAGGLE_DATA_DIR=

# --- Injury provider (optional; none bundled) ---
INJURY_DATA_PROVIDER=

# --- Live game polling (cdn.nba.com). Disabled by default; enable only in season. ---
LIVE_DATA_ENABLED=false

# --- Optional LLM prose enhancement for reports (never computes values) ---
ANTHROPIC_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
